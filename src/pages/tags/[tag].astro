---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicPosts, getUniqueTags } from '../../lib/content';
import { renderTrailerCards, toTrailer } from '../../lib/trailers';

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return getUniqueTags(posts).map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;
const filtered = posts.filter((post) =>
  (post.data.tags || []).some((currTag: string) => currTag.toLowerCase() === tag.toLowerCase()),
);
const cards = renderTrailerCards(filtered.map(toTrailer));
---

<BaseLayout title={`Tag: ${tag} | MotleyTech`} description={`Articles tagged ${tag}.`}>
  <section class="hero" style="padding-bottom: 1.5rem;">
    <p class="kicker">Tag</p>
    <h1><span class="gradient-text">#{tag}</span></h1>
    <p class="lede">
      {filtered.length} {filtered.length === 1 ? 'article' : 'articles'} on this topic.
    </p>
  </section>

  <ul class="trailer-grid" set:html={cards} />
</BaseLayout>
