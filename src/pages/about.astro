---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const pages = await getCollection('pages');
const aboutPage =
  pages.find((page) => page.data.slug === 'landing-page-about-hidden') ??
  pages[0];

if (!aboutPage) {
  throw new Error('No page content found for about page');
}

const { Content } = await render(aboutPage);
---

<PageLayout title={aboutPage.data.title} description={aboutPage.data.description}>
  <figure class="post-hero">
    <img class="trailer-media-blur" src="/images/motleytech-collage.png" alt="" aria-hidden="true" />
    <img src="/images/motleytech-collage.png" alt="Mosaic collage inspired by the blog topics" />
  </figure>
  <Content />
  <p class="kicker" style="margin-top: 2rem;">Built with Astro</p>
</PageLayout>
