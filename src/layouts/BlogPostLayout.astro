---
import BaseLayout from './BaseLayout.astro';
import DisqusComments from '../components/DisqusComments.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

interface Props {
  title: string;
  slug: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  category?: string;
  disqusIdentifier?: string;
  heroImage?: string;
  heroAlt?: string;
  readMinutes?: number;
  draft?: boolean;
}

const {
  title,
  slug,
  description,
  pubDate,
  tags = [],
  category = 'Blog',
  disqusIdentifier,
  heroImage,
  heroAlt = title,
  readMinutes,
  draft = false,
} = Astro.props;
---

<BaseLayout title={`${title} | MotleyTech`} description={description} noindex={draft}>
  <article class="post-content">
    <p class="kicker">{category}</p>
    <h1>{title}</h1>
    <p class="post-meta">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
      {readMinutes && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>{readMinutes} min read</span>
        </>
      )}
      <span aria-hidden="true">&middot;</span>
      <a href={`/categories/${category.toLowerCase()}`}>{category}</a>
    </p>
    {heroImage && (
      <figure class="post-hero">
        <img class="trailer-media-blur" src={heroImage} alt="" aria-hidden="true" />
        <img src={heroImage} alt={heroAlt} />
      </figure>
    )}
    {tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag) => (
          <a class="tag" href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}>{tag}</a>
        ))}
      </div>
    )}
    <slot />
    <RelatedPosts currentSlug={slug} />
    {disqusIdentifier && (
      <DisqusComments identifier={disqusIdentifier} title={title} />
    )}
  </article>
</BaseLayout>
