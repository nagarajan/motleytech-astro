---
import '../styles/themes.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'MotleyTech - variegated, technical and interesting',
  noindex = false,
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? 'G-V8WZYM91B4';

const themes = [
  { id: 'nebula', label: 'Nebula' },
  { id: 'synthwave', label: 'Synthwave' },
  { id: 'matrix', label: 'Matrix' },
  { id: 'ember', label: 'Ember' },
  { id: 'aurora', label: 'Aurora (light)' },
  { id: 'quartz', label: 'Quartz (light)' },
];
const defaultTheme = 'nebula';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/archives', label: 'Archive' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en" data-theme={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="MotleyTech" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <title>{title}</title>
    <!-- Applied before first paint so the chosen theme never flashes. -->
    <script is:inline define:vars={{ themeIds: themes.map((theme) => theme.id), defaultTheme }}>
      (function () {
        var stored = null;
        try {
          stored = window.localStorage.getItem('motleytech-theme');
        } catch (error) {
          stored = null;
        }
        var theme = themeIds.indexOf(stored) === -1 ? defaultTheme : stored;
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell topbar">
        <div class="topbar-main">
          <a href="/" class="site-title"><span class="gradient-text">MotleyTech</span></a>
          <nav id="site-nav" class="site-nav" aria-label="Primary">
            {navLinks.map((link) => (
              <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            ))}
          </nav>
        </div>
        <button
          id="nav-toggle"
          class="nav-toggle"
          type="button"
          aria-label="Open menu"
          aria-controls="menu-panel"
          aria-expanded="false"
        >
          <span class="hamburger-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
        <div id="menu-panel" class="menu-panel">
          <div class="theme-row">
            <label for="theme-select" class="theme-label">Theme</label>
            <select id="theme-select" class="theme-select" aria-label="Select theme">
              {themes.map((theme) => <option value={theme.id}>{theme.label}</option>)}
            </select>
          </div>
          <nav class="menu-nav" aria-label="Secondary">
            {navLinks.map((link) => (
              <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main class="shell site-main">
      <slot />
    </main>

    <footer class="shell site-footer">
      <p>&copy; 2017&ndash;2026 Nagarajan</p>
      <p><a href="/rss.xml">RSS</a> &middot; <a href="/archives">Archive</a></p>
    </footer>

    <script is:inline>
      (function () {
        const select = document.getElementById('theme-select');
        if (select) {
          select.value = document.documentElement.getAttribute('data-theme');
          select.addEventListener('change', function (event) {
            const theme = event.target.value;
            document.documentElement.setAttribute('data-theme', theme);
            try {
              window.localStorage.setItem('motleytech-theme', theme);
            } catch (error) {
              /* private browsing: the theme simply will not persist */
            }
          });
        }

        const header = document.querySelector('.site-header');
        const menu = document.getElementById('menu-panel');
        const button = document.getElementById('nav-toggle');
        if (!header || !menu || !button) {
          return;
        }

        function closeMenu() {
          header.classList.remove('menu-open');
          button.setAttribute('aria-expanded', 'false');
        }

        button.addEventListener('click', function () {
          const isOpen = header.classList.toggle('menu-open');
          button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });

        menu.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('click', function (event) {
          if (!header.classList.contains('menu-open')) {
            return;
          }
          const target = event.target;
          if (target instanceof Node && (menu.contains(target) || button.contains(target))) {
            return;
          }
          closeMenu();
        });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') {
            closeMenu();
          }
        });
      })();
    </script>
  </body>
</html>
