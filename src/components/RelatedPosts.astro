---
import { getTrailers, RELATED_COUNT, sample, toRelatedLink } from '../lib/trailers';

interface Props {
  /** The article being read, so it cannot recommend itself. */
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const picks = sample(
  (await getTrailers()).filter((trailer) => trailer.slug !== currentSlug).map(toRelatedLink),
  RELATED_COUNT,
);
---

{picks.length > 0 && (
  <section class="related" aria-labelledby="related-heading" data-related data-here={`/blog/${currentSlug}`}>
    <h2 id="related-heading">Also on MotleyTech</h2>
    <ul class="related-list">
      {picks.map((item) => (
        <li class="related-item">
          <a href={item.href}>
            {item.image ? (
              <img class="related-thumb" src={item.image} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="related-thumb related-thumb--empty" aria-hidden="true">
                {item.title.slice(0, 2).toUpperCase()}
              </span>
            )}
            <span class="related-body">
              <span class="related-meta">
                <time datetime={item.isoDate}>{item.stamp}</time>
                <span aria-hidden="true">&middot;</span>
                <span>{item.readMinutes} min read</span>
              </span>
              <span class="related-title">{item.title}</span>
              <span class="related-text">{item.snippet}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<script is:inline define:vars={{ count: RELATED_COUNT }}>
  (function () {
    const section = document.querySelector('[data-related]');
    const list = section && section.querySelector('.related-list');
    if (!list) return;

    const trim = (path) => path.replace(/\/+$/, '');
    const here = trim(section.dataset.here || location.pathname);

    function draw(items) {
      const pool = items.filter((item) => trim(item.href) !== here);
      for (let i = pool.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      const chosen = pool.slice(0, count);
      if (chosen.length < count) return;

      const fresh = document.createDocumentFragment();
      for (const item of chosen) {
        const li = document.createElement('li');
        li.className = 'related-item';

        const link = document.createElement('a');
        link.href = item.href;

        if (item.image) {
          const img = document.createElement('img');
          img.className = 'related-thumb';
          img.src = item.image;
          img.alt = '';
          img.loading = 'lazy';
          img.decoding = 'async';
          link.appendChild(img);
        } else {
          const badge = document.createElement('span');
          badge.className = 'related-thumb related-thumb--empty';
          badge.setAttribute('aria-hidden', 'true');
          badge.textContent = item.title.slice(0, 2).toUpperCase();
          link.appendChild(badge);
        }

        const body = document.createElement('span');
        body.className = 'related-body';

        const meta = document.createElement('span');
        meta.className = 'related-meta';
        const time = document.createElement('time');
        time.dateTime = item.isoDate;
        time.textContent = item.stamp;
        const dot = document.createElement('span');
        dot.setAttribute('aria-hidden', 'true');
        dot.innerHTML = '&middot;';
        const read = document.createElement('span');
        read.textContent = item.readMinutes + ' min read';
        meta.append(time, dot, read);

        const title = document.createElement('span');
        title.className = 'related-title';
        title.textContent = item.title;

        const text = document.createElement('span');
        text.className = 'related-text';
        text.textContent = item.snippet;

        body.append(meta, title, text);
        link.appendChild(body);
        li.appendChild(link);
        fresh.appendChild(li);
      }

      list.replaceChildren(fresh);
    }

    // The build already picked a set. Only swap it while the list is out of
    // sight, so nothing shifts under someone who is reading it.
    function onScreen() {
      const box = section.getBoundingClientRect();
      return box.top < window.innerHeight && box.bottom > 0;
    }

    fetch('/api/related.json')
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || !Array.isArray(data.items) || onScreen()) return;
        draw(data.items);
      })
      .catch(() => {
        /* the server-rendered set is already on the page */
      });
  })();
</script>
